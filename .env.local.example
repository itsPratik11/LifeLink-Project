# Real Cellular SMS Gateway Configuration (Optional)
# To send real SMS text messages to Indian phone numbers (+91), add your Fast2SMS API Key below:

FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Alternatively, for Twilio international SMS:
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
